<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<title>SoundPaid — Launch coins. Pay artists.</title>
<meta name="description" content="A Solana launchpad beta that routes launch fees to verified SoundCloud artists." />
<style>
:root{--bg:#07090b;--panel:#0f1317;--panel2:#141a20;--line:#24303a;--text:#f5f7f8;--muted:#8d9aa5;--lime:#b7ff4a;--green:#6cf5a8;--orange:#ff9d45;--red:#ff6b6b;--r:20px}*{box-sizing:border-box}body{margin:0;background:radial-gradient(1000px 500px at 65% -10%,#16331f 0,transparent 60%),var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,input,select{font:inherit}a{color:inherit}.wrap{max-width:1180px;margin:auto;padding:24px}.nav{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:8px 0 30px}.brand{display:flex;align-items:center;gap:10px;font-weight:900;letter-spacing:-.04em;font-size:24px}.mark{width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,var(--lime),var(--green));color:#071006;display:grid;place-items:center;font-weight:1000}.pill,.btn{border:1px solid var(--line);background:#10151a;color:var(--text);border-radius:999px;padding:11px 16px;cursor:pointer}.btn.primary{background:var(--lime);color:#071006;border-color:var(--lime);font-weight:900}.btn:disabled{opacity:.5;cursor:not-allowed}.hero{display:grid;grid-template-columns:1.25fr .75fr;gap:28px;align-items:stretch}.heroCard,.card{border:1px solid var(--line);background:linear-gradient(180deg,rgba(20,26,32,.9),rgba(10,14,17,.95));border-radius:var(--r);padding:28px;box-shadow:0 20px 70px rgba(0,0,0,.25)}.eyebrow{color:var(--lime);font-size:12px;font-weight:900;letter-spacing:.16em;text-transform:uppercase}h1{font-size:clamp(48px,8vw,96px);line-height:.9;letter-spacing:-.065em;margin:18px 0}.grad{background:linear-gradient(90deg,#fff,var(--lime));-webkit-background-clip:text;color:transparent}.sub{max-width:650px;color:#b7c1c9;font-size:18px;line-height:1.55}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:28px}.stat{background:#0a0e11;border:1px solid var(--line);border-radius:14px;padding:15px}.stat b{display:block;font-size:18px}.stat span{color:var(--muted);font-size:12px}.route{display:flex;flex-direction:column;justify-content:center;min-height:100%}.flow{display:grid;gap:12px;margin-top:20px}.step{display:flex;gap:12px;align-items:center}.num{width:30px;height:30px;border-radius:50%;background:#1c252c;display:grid;place-items:center;color:var(--lime);font-weight:800}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:34px 0 18px}.tab.active{background:#f2f5f6;color:#071006}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.sectionTitle{font-size:30px;letter-spacing:-.04em;margin:0 0 6px}.muted{color:var(--muted)}label{display:block;margin:16px 0 7px;font-size:12px;color:#b7c1c9;font-weight:800;text-transform:uppercase;letter-spacing:.08em}input,select{width:100%;border:1px solid var(--line);background:#090d10;color:var(--text);padding:13px 14px;border-radius:12px;outline:none}input:focus,select:focus{border-color:#647783}.row{display:flex;gap:10px;align-items:center}.row>*{flex:1}.notice{border:1px solid #2d3c46;background:#0a0f13;border-radius:14px;padding:14px 16px;color:#a9b5be;font-size:13px;line-height:1.45}.notice.ok{border-color:#285c3c;color:#a8f0c2}.notice.warn{border-color:#60451d;color:#ffd19b}.code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-weight:800;letter-spacing:.04em;color:var(--lime);word-break:break-all}.hidden{display:none!important}.artist{display:flex;justify-content:space-between;gap:16px;align-items:center;padding:14px 0;border-bottom:1px solid #1c252c}.artist:last-child{border:0}.artist a{color:#c4ff75}.badge{font-size:11px;padding:6px 9px;border-radius:999px;background:#15301f;color:#8affad}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.status{min-height:22px;margin-top:12px;color:#a8b4bd;font-size:13px}.mini{font-size:11px;color:#74818b;line-height:1.45}.footer{padding:38px 0 16px;color:#64717b;font-size:12px}.sol{color:#bfffa0}@media(max-width:800px){.hero,.grid{grid-template-columns:1fr}.stats{grid-template-columns:1fr}.wrap{padding:16px}.heroCard,.card{padding:20px}.nav{align-items:flex-start}.nav .pill{max-width:170px;overflow:hidden;text-overflow:ellipsis}.row{flex-direction:column;align-items:stretch}}
</style>
</head>
<body>
<div class="wrap">
  <div class="nav"><div class="brand"><div class="mark">S</div>soundpaid</div><button id="connect" class="pill">Connect Solana wallet</button></div>
  <section class="hero">
    <div class="heroCard"><div class="eyebrow">Solana launchpad beta</div><h1>Launch coins.<br><span class="grad">Pay artists.</span></h1><div class="sub">Create a Solana token and route the SoundPaid launch fee directly to a verified SoundCloud artist. Artist identity is tied to a public SoundCloud bio code and a signed wallet message.</div><div class="stats"><div class="stat"><b>100%</b><span>launch fee to artist</span></div><div class="stat"><b>2 proofs</b><span>bio code + wallet signature</span></div><div class="stat"><b>0 keys</b><span>site never asks for seed phrases</span></div></div></div>
    <div class="heroCard route"><div class="eyebrow">How money moves</div><div class="flow"><div class="step"><div class="num">1</div><div>Artist verifies SoundCloud + payout wallet</div></div><div class="step"><div class="num">2</div><div>Creator chooses the verified artist</div></div><div class="step"><div class="num">3</div><div>Wallet signs token launch + artist fee together</div></div><div class="step"><div class="num">4</div><div>Transaction is preflighted before broadcast</div></div></div></div>
  </section>

  <div class="tabs"><button class="tab btn active" data-tab="launch">Launch</button><button class="tab btn" data-tab="verify">Verify artist</button><button class="tab btn" data-tab="artists">Artists</button><button class="tab btn" data-tab="launches">Confirmed launches</button><button class="tab btn" data-tab="router">Fee router</button></div>

  <section id="launch" class="panel grid">
    <div class="card"><h2 class="sectionTitle">Launch a token</h2><div class="muted">Creates a standard SPL token on Solana mainnet, adds token metadata, fixes the supply, and pays the verified artist in the same transaction.</div>
      <label>Token name</label><input id="tokenName" maxlength="32" placeholder="Late Night Coin" />
      <div class="row"><div><label>Ticker</label><input id="tokenSymbol" maxlength="10" placeholder="LATE" /></div><div><label>Total supply</label><input id="tokenSupply" type="number" min="1" step="1" value="1000000000" /></div></div>
      <label>Token metadata URI <span class="mini">optional</span></label><input id="metadataUri" maxlength="200" placeholder="https://…/metadata.json or ipfs://…" /><div class="mini">Le