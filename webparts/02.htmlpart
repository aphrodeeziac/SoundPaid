badge">verified</span></div>`).join(''):'No verified artists yet.';}
 catch(e){$('artistList').textContent='Could not load artists.'}
}
loadArtists();

async function loadLaunches(){
 try{const r=await fetch('/api/launches',{cache:'no-store'}); const j=await r.json(); if(!r.ok) throw new Error(j.error||'Launch lookup failed'); const list=j.launches||[]; $('launchList').innerHTML=list.length?list.map(x=>`<div class="artist"><div><b>${esc(x.name)} <span class="sol">$${esc(x.symbol)}</span></b><div class="mini">Artist: <a href="${esc(x.soundcloudUrl)}" target="_blank" rel="noreferrer">${esc(artistName(x.soundcloudUrl))}</a> · ${(Number(x.feeLamports)/LAMPORTS_PER_SOL).toFixed(3)} SOL</div><div class="mini code">${esc(x.mint)}</div></div><div><a class="badge" href="https://solscan.io/tx/${esc(x.signature)}" target="_blank" rel="noreferrer">confirmed ↗</a></div></div>`).join(''):'No confirmed launches yet.';}catch(e){$('launchList').textContent='Could not load confirmed launches.'}
}

let activeChallenge=null;
$('challengeBtn').onclick=async()=>{try{if(!wallet) await connect(); const soundcloudUrl=$('scUrl').value.trim(); $('challengeStatus').textContent='Creating challenge…'; const r=await fetch('/api/challenge',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({wallet:wallet.toBase58(),soundcloudUrl})}); const j=await r.json(); if(!r.ok) throw new Error(j.error||'Challenge failed'); activeChallenge={code:j.code,soundcloudUrl:j.soundcloudUrl||soundcloudUrl}; $('bioCode').textContent=j.code; $('challengeBox').classList.remove('hidden'); $('challengeStatus').textContent='Bio code ready.';}catch(e){$('challengeStatus').textContent=e.message}};
$('verifyBtn').onclick=async()=>{try{if(!wallet||!activeChallenge) throw new Error('Generate a challenge first.'); const p=provider(); if(!p?.signMessage) throw new Error('Connected wallet does not support message signing.'); const message=`SoundPaid artist verification\nWallet: ${wallet.toBase58()}\nSoundCloud: ${activeChallenge.soundcloudUrl}\nCode: ${activeChallenge.code}`; $('challengeStatus').textContent='Approve the signed verification message…'; const signed=await p.signMessage(new TextEncoder().encode(message),'utf8'); const signature=bs58.encode(signed.signature); $('challengeStatus').textContent='Checking SoundCloud bio and wallet proof…'; const r=await fetch('/api/verify-artist',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({wallet:wallet.toBase58(),signature})}); const j=await r.json(); if(!r.ok) throw new Error(j.error||'Verification failed'); $('challengeStatus').textContent='Verified. This wallet can now receive SoundPaid fees.'; $('challengeBox').classList.add('hidden'); activeChallenge=null; await loadArtists();}catch(e){$('challengeStatus').textContent=e.message}};

async function signSimulateSend(tx,extraSigners=[]){
 const p=provider(); if(!wallet) await connect(); const latest=await connection.getLatestBlockhash('confirmed'); tx.feePayer=wallet; tx.recentBlockhash=latest.blockhash; if(extraSigners.length) tx.partialSign(...extraSigners); const signed=await p.signTransaction(tx); const sim=await connection.simulateTransaction(signed); if(sim.value.err) throw new Error('Preflight simulation failed: '+JSON.stringify(sim.value.err)); const sig=await connection.sendRawTransaction(signed.serialize(),{skipPreflight:false,maxRetries:3}); await connection.confirmTransaction({signature:sig,blockhash:latest.blockhash,lastValidBlockHeight:latest.lastValidBlockHeight},'confirmed'); return sig;
}

$('routerBtn').onclick=async()=>{try{if(!wallet) await connect(); const to=$('routerArtist').value; const amount=Number($('routerAmount').value); if(!to||!Number.isFinite(amount)||amount<=0) throw new Error('Choose a verified artist and a valid amount.'); $('routerStatus').textContent='Approve the transfer in your wallet…'; const tx=new Transaction().add(SystemProgram.transfer({fromPubkey:wallet,toPubkey:new PublicKey(to),lamports:Math.round(amount*LAMPORTS_PER_SOL)})); const sig=await signSimulateSend(tx); $('routerStatus').innerHTML=`Confirmed: <a target="_blank" rel="noreferrer" href="https://solscan.io/tx/${sig}">${short(sig)}</a>`;}catch(e){$('routerStatus').textContent=e.message}};

